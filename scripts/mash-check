#!/usr/bin/env python3
"""mash-check: measure whether fast presses survive the bridge, on real hardware.

Four modes, none needing root:

  ./scripts/mash-check --seconds 10   # mash during the countdown, get the live count
  ./scripts/mash-check --diag          # mash during the countdown, then diff in vs out
  ./scripts/mash-check --latency       # press during the countdown, get ms phys -> virtual
  ./scripts/mash-check --poll          # fit the pad's real USB report interval from the log
  ./scripts/mash-check --list          # which virtual pad nodes this tool can see

Both *wait for you*. Nothing is measured by pressing keys while a report command runs
afterwards: the second mode reads `/tmp/any-pad-bridge.*.diag`, which the bridge writes
continuously while it runs without its exclusive grab, so the mashing has to happen in
that state. And `--diag` counts only the bytes logged during its own countdown, so an
earlier mash cannot be mistaken for the one you are testing.

The full sequence for the strict test is:

  1. ANY_PAD_DIAG_NO_GRAB=1 ./scripts/any-pad-to-xbox
  2. select the pad, click Enable                     (asks for your password)
  3. ./scripts/mash-check --diag --seconds 10         (mash during the countdown)
  4. Enable again without the variable to go back     (normal play)

Mode 1 counts what a game receives: one down edge per recognized press, the rate, the
fastest gap, and any button left stuck down. Mode 2 answers, per pad and per control, how
many presses the pad sent versus how many the virtual pad emitted — the only state where
the physical side is observable separately is diag mode, because the bridge normally holds
an exclusive EVIOCGRAB on it.

stdlib only, so it runs under /usr/bin/python3 like the bridge itself.
"""

from __future__ import annotations

import argparse
import collections
import json
import os
import statistics
import struct
import subprocess
import sys
import time
from collections import defaultdict
from pathlib import Path

EVENT_FMT = "llHHi"
EVENT_SIZE = struct.calcsize(EVENT_FMT)
EV_SYN, EV_KEY, EV_ABS = 0x00, 0x01, 0x03

DIAG_DIR = Path("/tmp")
DIAG_LEGACY = Path("/tmp/any-pad-bridge.diag")
DIAG_LOG = DIAG_LEGACY  # pre-per-node builds
SYSTEM_PROFILES = Path("/etc/any-pad-to-xbox/profiles.json")
USER_PROFILES = Path.home() / ".config" / "any-pad-to-xbox" / "profiles.json"
BRIDGE_CANDIDATES = (
    Path(__file__).resolve().parent.parent / "packaging" / "xpad_bridge.py",
    Path("/usr/local/lib/any-pad-to-xbox/xpad_bridge.py"),
)
VIRTUAL_NAME = "Microsoft X-Box 360 pad"

# Virtual codes → the name the app uses, so output reads like the GUI.
XBOX_BTN_NAMES = {
    304: "a", 305: "b", 307: "x", 308: "y",
    310: "lb", 311: "rb", 312: "lt", 313: "rt",
    314: "back", 315: "start", 316: "guide",
}


def find_virtual_nodes() -> list[Path]:
    """event nodes whose device name is the uinput pad this project creates."""
    nodes = []
    for entry in sorted(Path("/sys/class/input").glob("event*")):
        name_file = entry / "device" / "name"
        try:
            if name_file.read_text(encoding="utf-8").strip() == VIRTUAL_NAME:
                nodes.append(Path("/dev/input") / entry.name)
        except OSError:
            continue
    return nodes


def tally(events) -> tuple[dict[int, list[float]], set[int]]:
    """Count recognized presses per button and report anything left held.

    A press is a 0→1 transition, matching how the bridge itself counts edges — repeats of
    value 1 without an intervening up (the pulse recovery) would otherwise double-count.
    Timestamps come from the kernel, so gaps measured here are the real ones.
    """
    downs: dict[int, list[float]] = defaultdict(list)
    state: dict[int, int] = {}
    for _ts, etype, code, value in events:
        if etype != EV_KEY:
            continue
        if value == 1 and state.get(code) != 1:
            downs[code].append(_ts)
        state[code] = value
    return downs, {code for code, value in state.items() if value == 1}


def monitor(nodes: list[Path], seconds: float) -> int:
    received: list[tuple[float, int, int, int]] = []
    fds = []
    for node in nodes:
        try:
            fds.append((node, os.open(str(node), os.O_RDONLY | os.O_NONBLOCK)))
        except OSError as exc:
            print(f"cannot read {node}: {exc}", file=sys.stderr)
    if not fds:
        print("no readable virtual pad node — is the bridge running?", file=sys.stderr)
        return 2

    deadline = time.monotonic() + seconds
    try:
        while time.monotonic() < deadline:
            ready = _select([fd for _node, fd in fds])
            for _node, fd in fds:
                if fd not in ready:
                    continue
                received.extend(_drain(fd))
    except KeyboardInterrupt:
        pass
    finally:
        for _node, fd in fds:
            os.close(fd)

    downs, stuck = tally(received)
    _report(downs, stuck, seconds)
    return 0


def _select(fds):
    import select

    r, _w, _x = select.select(fds, [], [], 0.2)
    return set(r)


def _drain(fd):
    try:
        data = os.read(fd, EVENT_SIZE * 256)
    except BlockingIOError:
        return
    for off in range(0, len(data) - EVENT_SIZE + 1, EVENT_SIZE):
        _tv_sec, _tv_usec, etype, code, value = struct.unpack_from(EVENT_FMT, data, off)
        yield (_tv_sec + _tv_usec / 1e6, etype, code, value)


def _report(downs, stuck, seconds) -> None:
    total = sum(len(v) for v in downs.values())
    print(f"\n{total} press(es) seen on the virtual pad in {seconds:.1f}s")
    print(f"{'button':8} {'presses':>8} {'press/s':>9} {'fastest gap':>13}")
    for code, stamps in sorted(downs.items(), key=lambda kv: -len(kv[1])):
        name = XBOX_BTN_NAMES.get(code, f"code{code}")
        gaps = [b - a for a, b in zip(stamps, stamps[1:])]
        rate = len(stamps) / seconds
        fastest = f"{min(gaps) * 1000:.1f} ms" if gaps else "-"
        print(f"{name:8} {len(stamps):>8} {rate:>9.1f} {fastest:>13}")
    if stuck:
        names = ", ".join(XBOX_BTN_NAMES.get(c, f"code{c}") for c in stuck)
        print(f"\nSTUCK DOWN at exit: {names} — that is a real bug, not a measurement")
    elif total == 0:
        print("\nNothing arrived. Press a button while it runs.")


def load_bridge_module():
    """The bridge itself, for its code tables — repo checkout or installed copy."""
    import importlib.util

    for candidate in BRIDGE_CANDIDATES:
        if not candidate.exists():
            continue
        spec = importlib.util.spec_from_file_location("xpad_bridge_for_mash_check", candidate)
        module = importlib.util.module_from_spec(spec)
        try:
            spec.loader.exec_module(module)
        except Exception as exc:  # a broken copy must not take the tool down
            print(f"could not load {candidate}: {exc}", file=sys.stderr)
            continue
        return module
    return None


def load_profiles() -> dict:
    for path in (SYSTEM_PROFILES, USER_PROFILES):
        try:
            return json.loads(path.read_text(encoding="utf-8")).get("profiles", {})
        except (OSError, ValueError):
            continue
    return {}


def diag_logs(diag_dir: Path | None = None) -> list[tuple[str, Path]]:
    """[(event node, path)] — one log per pad, since the runner names them by node.

    Falls back to the single legacy path. A legacy log cannot be attributed to one pad,
    so its report is totals-only instead of a guess.
    """
    diag_dir = DIAG_DIR if diag_dir is None else diag_dir
    found: list[tuple[str, Path]] = [
        (path.stem.split(".")[-1], path)
        for path in sorted(diag_dir.glob("any-pad-bridge.event*.diag"))
    ]
    if not found and DIAG_LEGACY.exists():
        found.append(("", DIAG_LEGACY))
    return found


def pad_id(node: str) -> str | None:
    """`vendor:product` for /dev/input/<node> — the key the profiles use."""
    if not node:
        return None
    try:
        out = subprocess.run(
            ["udevadm", "info", "-q", "property", f"/dev/input/{node}"],
            capture_output=True,
            text=True,
            check=False,
        ).stdout
    except OSError:
        return None
    values = dict(
        line.split("=", 1) for line in out.splitlines() if "=" in line and line.startswith("ID_")
    )
    vendor, product = values.get("ID_VENDOR_ID"), values.get("ID_MODEL_ID")
    return f"{vendor}:{product}" if vendor and product else None


def resolve(bridge, name: str) -> int | None:
    """`resolve_code` raises on an unknown name — this tool must degrade, not crash."""
    try:
        return bridge.resolve_code(name)
    except (KeyError, ValueError):
        return None


def key_pairs(bridge, profile: dict) -> tuple[list[tuple[int, int, str, str]], list[str]]:
    """(physical code, target code, xbox name, kind) for ONE pad's mapping.

    `kind` is "key" or "axis": a button mapped to `lt`/`rt` leaves the bridge as an
    `EV_ABS` ramp, so counting only KEY output lines would report those presses as lost.
    The DragonRise profile does exactly that for two of its ten buttons.

    Scoped to one profile on purpose: building the pairs from every profile in /etc mixes
    other pads' buttons into this pad's report — a physical code belonging to a different
    encoder shows up as "0 in", and a virtual code two pads share gets printed once per
    pad. That produced a confident, meaningless table.

    Joined on code numbers, not on the names in the log: the same press is BTN_THUMB in
    and BTN_A out.
    """
    pairs, level_only = [], []
    for phys_name, xbox in (profile.get("evdev_keymap") or {}).items():
        code = resolve(bridge, phys_name)
        if code is None:
            level_only.append(f"{phys_name}→{xbox}")
            continue
        virtual = bridge.XBOX_BTN_CODES.get(xbox)
        if virtual is not None:
            pairs.append((code, virtual, xbox, "key"))
            continue
        ramp = bridge.XBOX_ABS_CODES.get(xbox)
        if ramp is not None:
            pairs.append((code, ramp, xbox, "axis"))
            continue
        level_only.append(f"{phys_name}→{xbox}")
    # Directions arriving as an analog axis are level state in and out: no edge to count.
    level_only += [f"{name}→{xbox}" for name, xbox in (profile.get("evdev_absmap") or {}).items()]
    return pairs, level_only


def count_rises(bridge, lines, codes: set[int]) -> dict[int, int]:
    """0→nonzero transitions per EV_ABS code — a press on an axis-mapped trigger."""
    rises: dict[int, int] = dict.fromkeys(codes, 0)
    last: dict[int, int] = {}
    for line in lines:
        parts = line.split()
        if len(parts) < 5 or parts[2] != "ABS" or parts[1] not in {"EMIT", "PULSE"}:
            continue
        code = resolve(bridge, parts[3])
        if code not in codes:
            continue
        try:
            value = int(parts[4].split("=", 1)[1])
        except (ValueError, IndexError):
            continue
        if value and not last.get(code, 0):
            rises[code] += 1
        last[code] = value
    return rises


def count_downs(bridge, lines) -> tuple[dict[int, int], dict[int, int], dict[str, int]]:
    """(physical downs by code, virtual downs by code, names that did not resolve)."""
    phys: dict[int, int] = defaultdict(int)
    virt: dict[int, int] = defaultdict(int)
    unknown: dict[str, int] = defaultdict(int)
    for line in lines:
        parts = line.split()
        if len(parts) < 5 or parts[2] != "KEY" or parts[4] != "down":
            continue
        tag, name = parts[1], parts[3]
        if tag not in {"PHYS", "EMIT", "PULSE"}:
            continue
        code = resolve(bridge, name)
        if code is None:
            unknown[name] += 1
            continue
        (phys if tag == "PHYS" else virt)[code] += 1
    return phys, virt, unknown


def _no_diag_log() -> int:
    print(
        f"no {DIAG_DIR}/any-pad-bridge.*.diag found.\n"
        "That log only exists while the bridge runs without the exclusive grab:\n"
        "  1. ANY_PAD_DIAG_NO_GRAB=1 ./scripts/any-pad-to-xbox\n"
        "  2. click Enable on the pad      (asks for your password)\n"
        "  3. ./scripts/mash-check --diag  (mash during the countdown)",
        file=sys.stderr,
    )
    return 2


def profile_codes(bridge, profile: dict) -> set[int]:
    return {
        code
        for code in (resolve(bridge, name) for name in (profile.get("evdev_keymap") or {}))
        if code is not None
    }


def choose_profile(
    bridge, profiles: dict, ident: str | None, seen: set[int]
) -> tuple[dict | None, str]:
    """Which profile wrote this log.

    Named logs say so via their node. For a legacy log, infer only when exactly one
    profile covers every physical code observed — guessing here is how a table of invented
    losses got published once already.
    """
    if ident:
        profile = profiles.get(ident.lower())
        if profile is not None:
            return profile, ident
    candidates = [
        (key, profile)
        for key, profile in profiles.items()
        if seen and seen <= profile_codes(bridge, profile)
    ]
    if len(candidates) == 1:
        key, profile = candidates[0]
        return profile, f"{key} (inferred from the codes in the log)"
    return None, f"no profile for {ident}" if ident else f"{len(candidates)} profiles fit"


def read_since(path: Path, offset: int | None, window: float = 0) -> tuple[list[str], str]:
    """(lines to count, scope label). An offset means "only what arrived after it".

    Without this the sleep in --diag is theatre: the file already holds every press since
    the bridge started, so counting it all reports an earlier mash as if it were the one
    the user just did.
    """
    size = path.stat().st_size
    if offset is None:
        return path.read_text(encoding="utf-8").splitlines(), "the whole session"
    if size < offset:
        # The bridge restarted mid-window and reopened the log with mode "w".
        return path.read_text(encoding="utf-8").splitlines(), "the whole session (restarted)"
    with path.open(encoding="utf-8") as handle:
        handle.seek(offset)
        tail = handle.read()
    return tail.splitlines(), f"the last {window:.0f}s only"


def report_pad(node: str, path: Path, bridge, offset: int | None = None, window: float = 0) -> int:
    """One pad's PHYS-vs-virtual equivalence. Returns the number of unaccounted presses."""
    lines, scope = read_since(path, offset, window)
    header = next((line for line in lines if "BRIDGE start" in line), "")
    if not header:
        # The window began after the bridge started, so the header is behind the offset.
        header = next(
            (line for line in path.read_text(encoding="utf-8").splitlines() if "BRIDGE start" in line),
            "(no BRIDGE start line)",
        )
    age = time.time() - path.stat().st_mtime
    ident = pad_id(node)
    label = f"/dev/input/{node}" if node else "(legacy log path)"
    print(f"\n{label}{' [' + ident + ']' if ident else ''}\n  counting {scope}\n  session: {header or '(started before this window)'}")
    if age > 120:
        print("  WARNING: log has not been written for 2 minutes — the bridge may be idle.")

    phys, virt, unknown = count_downs(bridge, lines)
    if unknown:
        print("  code names this tool could not resolve: " + ", ".join(sorted(unknown)))
    if not phys:
        print(
            f"  no press arrived during {scope} — mash while it counts, or use --now"
            " to report the whole session."
        )
        return 0

    profiles = load_profiles()
    profile, how = choose_profile(bridge, profiles, ident, set(phys))
    if profile is None:
        print(f"  totals only ({how}): {sum(phys.values())} press(es) in / {sum(virt.values())} out")
        return 0
    print(f"  profile: {profile.get('name', '?')} [{how}]")

    pairs, level_only = key_pairs(bridge, profile)
    axis_targets = {virtual for _code, virtual, _xbox, kind in pairs if kind == "axis"}
    rises = count_rises(bridge, lines, axis_targets)

    # Aggregate by virtual control: several physical codes can share one target, and
    # iterating physical codes would print that target once per button.
    grouped: dict[int, dict] = {}
    for code, virtual, xbox, kind in pairs:
        entry = grouped.setdefault(virtual, {"xbox": xbox, "from": [], "in": 0, "kind": kind})
        entry["from"].append(bridge._code_name(code))
        entry["in"] += phys.get(code, 0)

    missing = 0
    print(f"  {'control':9}{'from':24}{'in':>5}{'out':>6}  verdict")
    for virtual, entry in sorted(grouped.items(), key=lambda kv: -kv[1]["in"]):
        sent = entry["in"]
        got = rises.get(virtual, 0) if entry["kind"] == "axis" else virt.get(virtual, 0)
        if not sent and not got:
            continue
        missing += abs(sent - got)
        verdict = (
            "lossless" if sent == got else f"{abs(sent - got)} {'lost' if sent > got else 'extra'}"
        )
        target = bridge._code_name(virtual) + (" (axis)" if entry["kind"] == "axis" else "")
        print(
            f"  {entry['xbox']:9}{', '.join(entry['from'])[:24]:24}{sent:>5}{got:>6}  {verdict}"
            f"  → {target}"
        )

    outside = sum(v for k, v in virt.items() if k not in grouped)
    if outside:
        print(f"  {outside} virtual down(s) outside this pad's button map.")
    if level_only:
        print("  level state, no edge to count (axis in): " + ", ".join(sorted(set(level_only))))
    print(
        "\n" + ("EVERY press accounted for." if missing == 0 else f"{missing} press(es) unaccounted for.")
    )
    return missing


def diag_run(seconds: float, wait: bool = True) -> int:
    """Every physical press must show up as a virtual down.

    The tool measures nothing on its own — the bridge writes the log while it runs in
    diag mode — so this waits first (mash during the countdown) and then reports.
    `--now` skips the wait and reads what is already in the file.
    """
    logs = diag_logs()
    if not logs:
        return _no_diag_log()

    bridge = load_bridge_module()
    if bridge is None:
        print("cannot load the bridge module — no code tables, no per-button report", file=sys.stderr)
        return 2

    if wait:
        # Mark where each log currently ends: only bytes written after this point belong
        # to the mash the user is about to do.
        marks = {node: path.stat().st_size for node, path in logs}
        print(f"Mash now: counting {seconds:.0f}s across {len(logs)} pad(s), then reporting.")
        time.sleep(seconds)
    else:
        marks = {}

    return (
        0
        if sum(
            report_pad(node, path, bridge, offset=marks.get(node), window=seconds)
            for node, path in logs
        )
        == 0
        else 1
    )


def pair_latencies(
    phys: list[tuple[float, int]],
    virt: list[tuple[float, int]],
    pairs: dict[int, int],
    stale_after: float = 0.5,
) -> tuple[list[float], int]:
    """Greedily match each virtual press to the earliest unmatched physical one.

    `phys` is (timestamp, physical code) rises, `virt` is (timestamp, target code) rises.
    Returns (deltas in ms, physical presses with no answer). Anything older than
    `stale_after` is counted as lost rather than paired — otherwise one swallowed press
    inflates every later latency on that button.
    """
    queues: dict[int, list[float]] = defaultdict(list)
    for ts, code in phys:
        target = pairs.get(code)
        if target is not None:
            queues[target].append(ts)

    deltas: list[float] = []
    lost = 0
    for ts, code in virt:
        queue = queues.get(code)
        if queue is None:
            continue
        while queue and ts - queue[0] > stale_after:
            queue.pop(0)
            lost += 1
        if queue:
            deltas.append((ts - queue.pop(0)) * 1000.0)
    return deltas, lost + sum(len(q) for q in queues.values())


def stats(values: list[float]) -> str:
    if not values:
        return "no samples"
    ordered = sorted(values)
    median = ordered[len(ordered) // 2]
    p95 = ordered[min(len(ordered) - 1, int(0.95 * len(ordered)))]
    mean = sum(ordered) / len(ordered)
    return (
        f"n={len(ordered)}  min {ordered[0]:.2f}  median {median:.2f}  "
        f"mean {mean:.2f}  p95 {p95:.2f}  max {ordered[-1]:.2f} ms"
    )


def find_physical_nodes(profile_ids: set[str]) -> list[tuple[str, Path]]:
    """[(vendor:product, node)] for mapped pads currently plugged in."""
    return [
        (ident.lower(), path)
        for path in sorted(Path("/dev/input").glob("event*"))
        if (ident := pad_id(path.name)) and ident.lower() in profile_ids
    ]


def parse_bridge_cmdline(cmd: str) -> tuple[str, bool] | None:
    """(event node, holds_grab) from an xpad_bridge command line, or None.

    The bridge is the thing that owns the physical node while a pad is mapped, and its
    argv says which node it reads and whether it took the exclusive grab.
    """
    args = cmd.split("\0")
    if not any(arg.endswith("xpad_bridge.py") for arg in args):
        return None
    node = next((a for a in args if a.startswith("event")), "")
    if not node:
        return None
    return node, "--no-grab" not in args


def grab_state_of(node_name: str) -> bool:
    """True when something holds an exclusive grab on /dev/input/<node_name>.

    Read from /proc rather than by trying EVIOCGRAB: a probe grab would steal the pad
    from the running bridge for a moment and drop real presses.
    """
    for entry in Path("/proc").glob("[0-9]*/cmdline"):
        try:
            parsed = parse_bridge_cmdline(entry.read_text(encoding="utf-8", errors="ignore"))
        except OSError:
            continue
        if parsed and parsed[0] == node_name:
            return parsed[1]
    return False


def measure_latency(seconds: float, device: str | None) -> int:
    """Kernel-timestamp latency from the physical event to the virtual one.

    This is the honest end-to-end number for what the bridge sits between: the physical
    stamp is when the kernel received the USB report, the virtual one when uinput injected
    the translated event. So it includes the device's USB polling interval and the kernel
    input layer — neither of which the bridge can avoid or add to.

    Needs diag mode: while the bridge holds the exclusive grab, every other reader of the
    physical node gets nothing, and the measurement would silently be one-sided.
    """
    profiles = load_profiles()
    enabled = {k.lower() for k, p in profiles.items() if p.get("enabled", True)}
    if device:
        pads = [((pad_id(Path(device).name) or "?").lower(), Path(device))]
    else:
        pads = [(i, p) for i, p in find_physical_nodes(enabled)]
    if not pads:
        print(
            "no mapped pad found. Pass it explicitly, and run the bridge in diag mode so "
            "the physical node is readable: ANY_PAD_DIAG_NO_GRAB=1, then Enable.",
            file=sys.stderr,
        )
        return 2

    blocked = [node for _ident, node in pads if grab_state_of(node.name)]
    if blocked:
        print(
            f"{' '.join(n.name for n in blocked)} is grabbed by the bridge, so no other "
            "reader can see it — --latency measures both sides and needs diag mode:\n"
            "  1. ANY_PAD_DIAG_NO_GRAB=1 ./scripts/any-pad-to-xbox\n"
            "  2. Enable                        (asks for your password)\n"
            "  3. ./scripts/mash-check --latency\n"
            "  4. Enable again without the variable to go back to playing",
            file=sys.stderr,
        )
        return 2

    bridge = load_bridge_module()
    if bridge is None:
        print("cannot load the bridge module — no code tables", file=sys.stderr)
        return 2

    virt_nodes = find_virtual_nodes()
    if not virt_nodes:
        print("no virtual pad node — is a bridge running?", file=sys.stderr)
        return 2

    print(
        f"One window per pad ({seconds:.0f}s each). Press that pad while it counts."
    )

    all_deltas: list[float] = []
    for ident, phys_node in pads:
        profile = profiles.get(ident)
        if profile is None:
            print(f"{phys_node}: no profile for {ident}, skipped", file=sys.stderr)
            continue
        pairs, axis_codes = {}, set()
        for phys_name, xbox in (profile.get("evdev_keymap") or {}).items():
            code = resolve(bridge, phys_name)
            target = bridge.XBOX_BTN_CODES.get(xbox, bridge.XBOX_ABS_CODES.get(xbox))
            if code is None or target is None:
                continue
            pairs[code] = target
            if target in bridge.XBOX_ABS_CODES.values():
                axis_codes.add(target)
        if not pairs:
            print(f"{phys_node}: nothing mappable in {ident}, skipped", file=sys.stderr)
            continue
        print(f"  pressing on {phys_node} now…")
        phys, virt = collect_rises(phys_node, virt_nodes[0], seconds, axis_codes)
        deltas, lost = pair_latencies(phys, virt, pairs)
        # Say what was seen before saying what it means: "no samples" alone cannot tell
        # nobody-pressed apart from one-sided-visibility or an empty mapping.
        print(
            f"  saw {len(phys)} physical rise(s), {len(virt)} virtual press(es), "
            f"{len(pairs)} mapped control(s)"
        )
        print(f"{phys_node} → {virt_nodes[0]}  {stats(deltas)}")
        if not deltas and virt and not phys:
            print("  nothing arrived on the physical side while the virtual side did")
        if lost:
            print(f"  {lost} physical press(es) never came out as a virtual press")
        all_deltas += deltas
    return 0 if all_deltas else 1


def tally_rises(events, axis_codes: set[int]) -> tuple[list, list]:
    """Split (label, ts, etype, code, value) frames into (physical rises, virtual rises).

    A virtual "press" is either an EV_KEY down or a 0→nonzero ramp on an axis target,
    because a button mapped to lt/rt leaves the bridge as EV_ABS.
    """
    phys: list[tuple[float, int]] = []
    virt: list[tuple[float, int]] = []
    axis_last: dict[int, int] = {}
    for label, ts, etype, code, value in events:
        if etype == EV_KEY and value == 1:
            (phys if label == "phys" else virt).append((ts, code))
        elif label == "virt" and etype == EV_ABS and code in axis_codes:
            if value and not axis_last.get(code, 0):
                virt.append((ts, code))
            axis_last[code] = value
    return phys, virt


def collect_rises(
    phys_node: Path, virt_node: Path, seconds: float, axis_codes: set[int]
):
    """(physical rises, virtual rises) with kernel timestamps, for one window."""
    fds = {}
    for label, node in (("phys", phys_node), ("virt", virt_node)):
        try:
            fds[label] = os.open(str(node), os.O_RDONLY | os.O_NONBLOCK)
        except OSError as exc:
            print(f"cannot read {node}: {exc}", file=sys.stderr)
            for handle in fds.values():
                os.close(handle)
            return [], []
    frames = []
    try:
        deadline = time.monotonic() + seconds
        while time.monotonic() < deadline:
            for fd in _select(list(fds.values())):
                label = next(k for k, v in fds.items() if v == fd)
                frames.extend((label, *event) for event in _drain(fd))
    finally:
        for handle in fds.values():
            os.close(handle)
    return tally_rises(frames, axis_codes)


def phys_timestamps(lines) -> list[float]:
    """Timestamps of every PHYS line, in file order (the bridge reads them in order)."""
    out = []
    for line in lines:
        parts = line.split()
        if len(parts) > 2 and parts[1] == "PHYS":
            try:
                out.append(float(parts[0]))
            except ValueError:
                continue
    return out


def report_gaps(
    stamps: list[float], same_report_below_ms: float = 0.3, max_gap_ms: float = 250.0
) -> list[float]:
    """Gaps between *distinct* USB reports, in ms.

    Several events share one report (a tap's down and up, or a dpad pair), landing within
    microseconds of each other. They are not evidence about the poll interval, and mixing
    them in would drag the answer toward zero. The cut is absolute (0.3 ms), not relative
    to the interval, so a 1 ms poll still shows its 1 ms gaps.

    The ceiling is the other half: a pad left idle for 30 s produces a gap that is a
    multiple of nothing — it measures when the human moved, not how the device is polled.
    """
    gaps = [(b - a) * 1000 for a, b in zip(stamps, stamps[1:])]
    return [g for g in gaps if same_report_below_ms <= g <= max_gap_ms]


def estimate_poll_interval(gaps: list[float], tol_ms: float = 0.4) -> tuple[int | None, float]:
    """The USB poll interval the gaps are consistent with, or None if nothing fits.

    The largest candidate dividing them all, not the smallest: every gap that is a
    multiple of 8 is also a multiple of 4, 2 and 1, so "smallest fits" always answers 1
    and means nothing. That also makes the tolerance load-bearing — a loose one lets 1 ms
    divide anything and silently becomes the answer. Jitter here is sub-0.1 ms (bridge-side
    stamps of one read batch), so 0.4 leaves room without degenerating.

    Even so, "8 ms fits" is not proof the device was polled every 8 ms: if no gap of 8 ms
    was ever observed, the data only shows the lattice's spacing, and poll_report says so.
    """
    if not gaps:
        return None, 0.0
    best: tuple[int | None, float] = (None, 0.0)
    for candidate in range(1, 17):
        hits = sum(1 for g in gaps if abs(g / candidate - round(g / candidate)) * candidate <= tol_ms)
        fraction = hits / len(gaps)
        if fraction >= 0.9 and (best[0] is None or candidate > best[0]):
            best = (candidate, fraction)
    return best


def poll_report(path: Path, offset: int | None, window: float) -> None:
    lines, scope = read_since(path, offset, window)
    stamps = phys_timestamps(lines)
    gaps = report_gaps(stamps)
    header = next((l for l in lines if "BRIDGE start" in l), "(no BRIDGE start line)")
    print(f"\n{path.name}  counting {scope}\n  session: {header}")
    if len(gaps) < 20:
        print(f"  only {len(gaps)} inter-report gap(s) — press the pad and try again")
        return
    interval, fit = estimate_poll_interval(gaps)
    ordered = sorted(gaps)
    print(f"  {len(stamps)} events, {len(gaps)} gaps (bursts inside one report excluded)")
    print(
        f"  min {ordered[0]:.2f} ms  median {statistics.median(ordered):.2f} ms  "
        f"max {ordered[-1]:.2f} ms"
    )
    if interval is None:
        print("  no clean poll interval — the gaps are not a lattice")
    else:
        print(f"  poll interval: {interval} ms ({1000 / interval:.0f} Hz), fits {100 * fit:.1f}% of gaps")
        if ordered[0] > interval * 1.5:
            print(
                f"  smallest gap seen is {ordered[0]:.2f} ms, so {interval} ms is the best fit "
                f"of the observed data, not proof the device was polled faster"
            )
    peaks = collections.Counter(round(g) for g in gaps).most_common(6)
    print("  most common gaps (ms): " + ", ".join(f"{g}×{c}" for g, c in peaks))


def poll_run(seconds: float, wait: bool = True) -> int:
    """Characterise the pad's real USB poll interval from the diag log.

    The number that dominates the latency chain, and the one to re-measure after
    changing `usbhid jspoll` — before/after in two runs.
    """
    logs = diag_logs()
    if not logs:
        return _no_diag_log()
    marks = {node: path.stat().st_size for node, path in logs} if wait else {}
    if wait:
        print(f"Mash now: measuring the report cadence for {seconds:.0f}s.")
        time.sleep(seconds)
    for node, path in logs:
        poll_report(path, marks.get(node), seconds)
    return 0


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--seconds", type=float, default=10.0, help="window to watch (default 10)")
    parser.add_argument(
        "--diag",
        action="store_true",
        help="wait --seconds while you mash, then diff in vs out for that window only",
    )
    parser.add_argument(
        "--now", action="store_true", help="with --diag: report the whole session, no wait"
    )
    parser.add_argument(
        "--latency",
        action="store_true",
        help="measure kernel-timestamp delay from the physical event to the virtual one",
    )
    parser.add_argument(
        "--poll",
        action="store_true",
        help="measure the pad's real USB report interval from the diag log (jspoll A/B)",
    )
    parser.add_argument("--list", action="store_true", help="show the virtual pad nodes found")
    parser.add_argument("device", nargs="*", help="explicit /dev/input/eventN to watch")
    args = parser.parse_args(argv)

    if args.list:
        nodes = find_virtual_nodes()
        print("\n".join(f"{n} ({VIRTUAL_NAME})" for n in nodes) or "none found")
        return 0
    if args.poll:
        return poll_run(args.seconds, wait=not args.now)
    if args.latency:
        return measure_latency(args.seconds, args.device[0] if args.device else None)
    if args.diag:
        return diag_run(args.seconds, wait=not args.now)

    nodes = [Path(d) for d in args.device] if args.device else find_virtual_nodes()
    if not nodes:
        print("no virtual pad node found — is a pad mapped and enabled?", file=sys.stderr)
        return 2
    print(f"watching {', '.join(str(n) for n in nodes)} for {args.seconds:.0f}s — mash now")
    return monitor(nodes, args.seconds)


if __name__ == "__main__":
    sys.exit(main())
